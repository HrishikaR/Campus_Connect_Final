# CampusConnect - Environment Configuration Example

# Gemini AI API Key (Optional - for smart search & insights)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="http://localhost:3000"

# MongoDB Database URI
# Supports local MongoDB instance or MongoDB Atlas Cloud instance
MONGODB_URI="mongodb://127.0.0.1:27017/campusconnect"

# JWT Authentication Secrets
JWT_SECRET="campusconnect_jwt_secret_key_2026_production_grade"
REFRESH_TOKEN_SECRET="campusconnect_refresh_token_secret_key_2026_production_grade"

# Cloudinary Configuration (Optional - for avatar & image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
